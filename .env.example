# ---------- سرور ----------
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
# آدرس عمومی سامانه (در لینک ایمیل/پیامک استفاده می‌شود)
APP_URL=https://support.softmiliac.com
# دامنه‌های مجاز CORS (با کاما جدا کنید)
CORS_ORIGINS=https://support.softmiliac.com
# یک رشته تصادفی طولانی: openssl rand -hex 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_DAYS=14
# مسیر ذخیره دیتابیس و فایل‌ها (در داکر: /data)
DATA_DIR=./data
# پشت Nginx/Cloudflare هستید؟ (برای IP واقعی کاربران)
TRUST_PROXY=true

# ---------- مدیر اولیه (فقط بار اول ساخته می‌شود) ----------
ADMIN_NAME=مدیر سیستم
ADMIN_EMAIL=admin@softmiliac.com
ADMIN_PASSWORD=Admin@12345

# ---------- ایمیل (SMTP) — اختیاری ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=پشتیبانی میلیونر <support@softmiliac.com>

# ---------- پیامک (کاوه‌نگار) — اختیاری ----------
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=
